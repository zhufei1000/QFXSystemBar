package-as: QFXSystemBar
changelog-title: QFXSystemBar

# Upload the English CHANGELOG.md as the per-file release notes on CurseForge.
# The packager reads it from the repository root even when excluded from the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  QFXSystemBar/QFXSystemBar: QFXSystemBar
  QFXSystemBar/QFXSystemBar_Config: QFXSystemBar_Config
  QFXSystemBar/QFXSystemBar_InfoBar: QFXSystemBar_InfoBar
  QFXSystemBar/QFXSystemBar_Locale: QFXSystemBar_Locale
  QFXSystemBar/QFXSystemBar_MeetingStone: QFXSystemBar_MeetingStone

ignore:
  - .workbuddy
  - CHANGELOG-qfx.txt
  - archive
  - .agents
  - .codex
  - .github
  - .gitignore
  - .release
  - AGENTS.md
  - CONTRIBUTING.md
  - CHANGELOG.md
  - README.md
  - LOCALIZATION_NOTES.md
  - _backups
  - docs
  - tests
  - tools
  # Artwork sources stay in the repository; the client uses the BLP textures.
  - QFXSystemBar/Media/MicroMenu/GameIcons/Achievement.tga
  - QFXSystemBar/Media/MicroMenu/GameIcons/Bags.tga
  - QFXSystemBar/Media/MicroMenu/GameIcons/Character.tga
