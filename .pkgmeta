package-as: QFXSystemBar
changelog-title: QFXSystemBar

# Upload the English CHANGELOG.md as the per-file release notes on CurseForge.
# The file must live at the repository root so its staged copy sits at the
# package root and survives the move-folders step (a copy inside a moved
# folder goes stale before upload, which fails the CF payload).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  QFXSystemBar/QFXSystemBar: QFXSystemBar
  QFXSystemBar/QFXSystemBar_Config: QFXSystemBar_Config
  QFXSystemBar/QFXSystemBar_InfoBar: QFXSystemBar_InfoBar
  QFXSystemBar/QFXSystemBar_Locale: QFXSystemBar_Locale
  QFXSystemBar/QFXSystemBar_MeetingStone: QFXSystemBar_MeetingStone

ignore:
  - .agents
  - .codex
  - .github
  - .gitignore
  - CONTRIBUTING.md
  - README.md
  - LOCALIZATION_NOTES.md
  - _backups
  - tests
